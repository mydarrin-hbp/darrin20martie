FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_GATE_USERNAME
ARG NEXT_PUBLIC_GATE_PASSWORD
ARG NEXT_PUBLIC_BACKEND_GATE_AUTHORIZATION

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_GATE_USERNAME=$NEXT_PUBLIC_GATE_USERNAME
ENV NEXT_PUBLIC_GATE_PASSWORD=$NEXT_PUBLIC_GATE_PASSWORD
ENV NEXT_PUBLIC_BACKEND_GATE_AUTHORIZATION=$NEXT_PUBLIC_BACKEND_GATE_AUTHORIZATION

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 8080

CMD ["node", "server.js"]
