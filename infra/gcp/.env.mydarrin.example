PROJECT_ID=mydarrin-platform
REGION=europe-west3

FRONTEND_SERVICE=mydarrin-frontend
BACKOFFICE_SERVICE=mydarrin-backoffice
BACKEND_SERVICE=mydarrin-backend

PUBLIC_STAGE_DOMAIN=mydarrin.homebestpal.com
PUBLIC_PROD_DOMAIN=www.mydarrin.com
ADMIN_DOMAIN=admin.mydarrin.homebestpal.com
API_DOMAIN=api.mydarrin.homebestpal.com

NEXT_PUBLIC_API_BASE_URL=https://api.mydarrin.homebestpal.com
API_BASE_URL_PUBLIC=https://api.mydarrin.homebestpal.com
BACKEND_GATE_AUTHORIZATION=Basic CHANGE_ME
NEXT_PUBLIC_BACKEND_GATE_AUTHORIZATION=Basic CHANGE_ME

NEXT_PUBLIC_GATE_USERNAME=SET_IN_SECRET_MANAGER_OR_ENV
NEXT_PUBLIC_GATE_PASSWORD=SET_IN_SECRET_MANAGER_OR_ENV

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/mydarrin?sslmode=require
DATABASE_URL_CLOUD_RUN=postgresql+psycopg://USER:PASSWORD@/mydarrin?host=/cloudsql/PROJECT:REGION:INSTANCE
CLOUD_SQL_INSTANCE_CONNECTION_NAME=mydarrin-platform:europe-west9:mydarrin-db
JWT_SECRET=CHANGE_ME
GOOGLE_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
BASIC_AUTH_GATE_USERNAME=SET_IN_SECRET_MANAGER_OR_ENV
BASIC_AUTH_GATE_PASSWORD=SET_IN_SECRET_MANAGER_OR_ENV

ATTACHMENTS_STORAGE_BACKEND=gcs
GCS_ATTACHMENTS_BUCKET=mydarrin-secure-attachments
GCS_ATTACHMENTS_PREFIX=attachments
