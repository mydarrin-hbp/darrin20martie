# My Darrin production deploy environment
# Source of truth for infra/gcp/deploy-mydarrin.ps1

# Project
PROJECT_ID=mydarrin-platform
REGION=europe-west3

# Cloud Run services
FRONTEND_SERVICE=mydarrin-frontend
BACKOFFICE_SERVICE=mydarrin-backoffice
BACKEND_SERVICE=mydarrin-backend

# Domains
PUBLIC_STAGE_DOMAIN=mydarrin.homebestpal.com
PUBLIC_PROD_DOMAIN=www.mydarrin.com
ADMIN_DOMAIN=admin.mydarrin.homebestpal.com
API_DOMAIN=api.mydarrin.homebestpal.com

# Public/API wiring
# API URLs are derived from API_DOMAIN by deploy-mydarrin.ps1, but are kept here for clarity.
NEXT_PUBLIC_API_BASE_URL=https://api.mydarrin.homebestpal.com
API_BASE_URL_PUBLIC=https://api.mydarrin.homebestpal.com
BACKEND_CORS_ORIGINS=https://mydarrin.homebestpal.com,https://admin.mydarrin.homebestpal.com

# Gate / admin access
BACKEND_GATE_AUTHORIZATION=Basic bXlkYXJyaW4uaGJwQGdtYWlsLmNvbTpBZG1pbkZpbGlwZXN0aSExOTk2
NEXT_PUBLIC_BACKEND_GATE_AUTHORIZATION=Basic bXlkYXJyaW4uaGJwQGdtYWlsLmNvbTpBZG1pbkZpbGlwZXN0aSExOTk2
NEXT_PUBLIC_GATE_USERNAME=mydarrin.hbp@gmail.com
NEXT_PUBLIC_GATE_PASSWORD=AdminFilipesti!1996
ENABLE_BASIC_AUTH_GATE=true
BASIC_AUTH_GATE_USERNAME=mydarrin.hbp@gmail.com
BASIC_AUTH_GATE_PASSWORD=AdminFilipesti!1996

# Database / Cloud SQL
DATABASE_URL=postgresql+psycopg://mydarrin_app:6zo%3Av%5EQOHb%25S61-%5C@34.155.95.43:5432/mydarrin?sslmode=require
DATABASE_URL_CLOUD_RUN=postgresql+psycopg://mydarrin_app:6zo%3Av%5EQOHb%25S61-%5C@/mydarrin?host=/cloudsql/mydarrin-platform:europe-west9:mydarrin-db
CLOUD_SQL_INSTANCE_CONNECTION_NAME=mydarrin-platform:europe-west9:mydarrin-db
JWT_SECRET=mydarrin-super-secure-jwt-secret-2026-auth-rbac-key

# Storage
ATTACHMENTS_STORAGE_BACKEND=gcs
GCS_ATTACHMENTS_BUCKET=mydarrin-secure-attachments
GCS_ATTACHMENTS_PREFIX=attachments

# External APIs
GOOGLE_API_KEY=SET_IN_SECRET_MANAGER_OR_ENV
GEMINI_API_KEY=SET_IN_SECRET_MANAGER_OR_ENV
